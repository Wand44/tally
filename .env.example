# Local SQLite file. Swap for a Turso URL (libsql://...) or Postgres later.
DATABASE_URL="file:./local.db"
# Only needed for a remote libSQL/Turso database.
DATABASE_AUTH_TOKEN=

# Model provider (M2). Without NEBIUS_API_KEY, Tally falls back to the
# built-in rules in lib/offline-provider.ts so the demo still works.
# The same four variables make `npm run eval` compare the two real models.
# Recommended IDs that are responsive on Token Factory right now:
# MODEL_FAST=nvidia/NVIDIA-Nemotron-3-Nano-30B-A3B
# MODEL_SMART=Qwen/Qwen3-235B-A22B-Instruct-2507
# NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1
NEBIUS_API_KEY=
NEBIUS_BASE_URL=
MODEL_FAST=
MODEL_SMART=
# Web search behind Radar and the market range (M4). Without it the search
# falls back to the built-in sample set in lib/search.ts.
TAVILY_API_KEY=

# AI runs allowed per hour per client (Radar search = 1 + one per posting read,
# Pricer and Proposal = 1 each, Guardian = 1, scope extraction = 1). 20 is the
# safe default for a public demo on a shared key; raise it for your own key.
AI_RUNS_PER_HOUR=
